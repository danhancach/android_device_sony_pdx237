+ssize_t DirectOutputThread::threadLoop_write()
+{
+    // Chi DIRECT PCM. OFFLOAD ke thua class nay nhung mType khac DIRECT.
+    // Lan ghi dau cua buffer (remaining == current) moi tron. Ghi le sau do dung offset
+    // tren cung buffer da tron, khong tron lai.
+    if (direct_pcm_mono::shouldBlendDirectPcm(
+                mDirectMono.load(), mType == DIRECT, audio_has_proportional_frames(mFormat))
+            && mBytesRemaining == mCurrentWriteLength && mFrameSize != 0
+            && direct_pcm_mono::frameStrideMatches(
+                    mFrameSize, mChannelCount, mHapticChannelCount,
+                    audio_bytes_per_sample(mFormat))) {
+        direct_pcm_mono::PcmSample sample = direct_pcm_mono::PcmSample::kUnsupported;
+        switch (mFormat) {
+            case AUDIO_FORMAT_PCM_16_BIT:
+                sample = direct_pcm_mono::PcmSample::kS16;
+                break;
+            case AUDIO_FORMAT_PCM_32_BIT:
+            case AUDIO_FORMAT_PCM_8_24_BIT:
+                sample = direct_pcm_mono::PcmSample::kS32;
+                break;
+            case AUDIO_FORMAT_PCM_24_BIT_PACKED:
+                sample = direct_pcm_mono::PcmSample::kS24Packed;
+                break;
+            case AUDIO_FORMAT_PCM_FLOAT:
+                sample = direct_pcm_mono::PcmSample::kFloat;
+                break;
+            default:
+                break;
+        }
+        const size_t frames = mCurrentWriteLength / mFrameSize;
+        direct_pcm_mono::averageAudioChannels(
+                mSinkBuffer, sample, mChannelCount, mHapticChannelCount, frames);
+    }
+    return PlaybackThread::threadLoop_write();
+}
