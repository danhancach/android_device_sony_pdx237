@@ -0,0 +1,27 @@
+package com.android.server.audio;
+
+// Host check. Khong nam trong src Soong cua services.
+public final class SpeakerPortraitMonoPolicyCheck {
+    public static void main(String[] args) {
+        check(SpeakerPortraitMonoPolicy.degreesFromSurfaceRotation(0) == 0, "rot 0");
+        check(SpeakerPortraitMonoPolicy.degreesFromSurfaceRotation(1) == 90, "rot 90");
+        check(SpeakerPortraitMonoPolicy.degreesFromSurfaceRotation(2) == 180, "rot 180");
+        check(SpeakerPortraitMonoPolicy.degreesFromSurfaceRotation(3) == 270, "rot 270");
+        check(SpeakerPortraitMonoPolicy.degreesFromSurfaceRotation(9)
+                == SpeakerPortraitMonoPolicy.ROTATION_UNKNOWN, "unknown surface");
+        check(SpeakerPortraitMonoPolicy.isRequested(true, 0), "portrait pref");
+        check(SpeakerPortraitMonoPolicy.isRequested(true, 180), "reverse portrait");
+        check(!SpeakerPortraitMonoPolicy.isRequested(true, 90), "landscape same pref");
+        check(!SpeakerPortraitMonoPolicy.isRequested(true, 270), "reverse landscape");
+        check(!SpeakerPortraitMonoPolicy.isRequested(true, SpeakerPortraitMonoPolicy.ROTATION_UNKNOWN),
+                "unknown does not keep portrait");
+        check(!SpeakerPortraitMonoPolicy.isRequested(false, 0), "pref off");
+        System.out.println("ok");
+    }
+
+    private static void check(boolean cond, String name) {
+        if (!cond) {
+            throw new AssertionError(name);
+        }
+    }
+}
diff --git a/services/audiopolicy/managerdefault/speaker_portrait_mono_test.cpp b/services/audiopolicy/managerdefault/speaker_portrait_mono_test.cpp
new file mode 100644
index 0000000000..f2cfb9bb63
--- /dev/null
+++ b/services/audiopolicy/managerdefault/speaker_portrait_mono_test.cpp
@@ -0,0 +1,197 @@
+#include "SpeakerPortraitMono.h"
+#include "../../audioflinger/DirectPcmMono.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+using direct_pcm_mono::averageAudioChannels;
+using direct_pcm_mono::frameStrideMatches;
+using direct_pcm_mono::PcmSample;
+using direct_pcm_mono::readS24Le;
+using direct_pcm_mono::shouldBlendDirectPcm;
+using speaker_portrait_mono::isBuiltinLoudspeakerOnly;
+using speaker_portrait_mono::isRequested;
+using speaker_portrait_mono::outputShouldMono;
+using speaker_portrait_mono::shouldInvalidateMmapMovedToSpeaker;
+using speaker_portrait_mono::shouldInvalidateOffloadMovedToSpeaker;
+using speaker_portrait_mono::shouldRefuseMmapOnSpeaker;
+
+static int gFailures = 0;
+
+static void expect(bool cond, const char* name) {
+    if (!cond) {
+        std::fprintf(stderr, "FAIL %s\n", name);
+        gFailures++;
+    }
+}
+
+int main() {
+    expect(isRequested(true, 0), "pref on portrait 0");
+    expect(isRequested(true, 180), "pref on portrait 180");
+    expect(!isRequested(true, 90), "pref on landscape 90");
+    expect(!isRequested(true, 270), "pref on landscape 270");
+    expect(!isRequested(false, 0), "pref off portrait");
+    expect(!isRequested(true, -1), "unknown rotation");
+
+    const unsigned speaker = speaker_portrait_mono::kDeviceOutSpeaker;
+    const unsigned safe = speaker_portrait_mono::kDeviceOutSpeakerSafe;
+    const unsigned headset = 0x4u;
+    const unsigned a2dp = 0x80u;
+
+    std::vector<unsigned> empty;
+    std::vector<unsigned> spk{speaker};
+    std::vector<unsigned> both{speaker, safe};
+    std::vector<unsigned> wired{speaker, headset};
+    std::vector<unsigned> bt{a2dp};
+
+    expect(!isBuiltinLoudspeakerOnly(empty.begin(), empty.end()), "empty route");
+    expect(isBuiltinLoudspeakerOnly(spk.begin(), spk.end()), "speaker");
+    expect(isBuiltinLoudspeakerOnly(both.begin(), both.end()), "speaker safe");
+    expect(!isBuiltinLoudspeakerOnly(wired.begin(), wired.end()), "speaker plus wired");
+    expect(!isBuiltinLoudspeakerOnly(bt.begin(), bt.end()), "a2dp");
+
+    expect(outputShouldMono(true, false, false), "a11y mono keeps headphone");
+    expect(!outputShouldMono(false, false, true), "pref off speaker");
+    expect(outputShouldMono(false, true, true), "portrait request speaker");
+    expect(!outputShouldMono(false, true, false), "portrait request external");
+    expect(outputShouldMono(true, false, false), "a11y independent of pref");
+
+    expect(shouldInvalidateOffloadMovedToSpeaker(true, true, true, false),
+            "offload external to speaker");
+    expect(!shouldInvalidateOffloadMovedToSpeaker(true, true, true, true),
+            "offload already on speaker");
+    expect(!shouldInvalidateOffloadMovedToSpeaker(true, true, false, true),
+            "offload speaker to external");
+    expect(!shouldInvalidateOffloadMovedToSpeaker(true, false, true, false),
+            "direct pcm route change is not offload invalidate");
+    expect(!shouldInvalidateOffloadMovedToSpeaker(false, true, true, false),
+            "offload move while preference off");
+
+    expect(shouldRefuseMmapOnSpeaker(true, true, true), "mmap speaker refused");
+    expect(!shouldRefuseMmapOnSpeaker(true, true, false), "mmap external stays");
+    expect(!shouldRefuseMmapOnSpeaker(false, true, true), "mmap speaker when request off");
+    expect(!shouldRefuseMmapOnSpeaker(true, false, true), "non-mmap speaker not refused here");
+
+    expect(shouldInvalidateMmapMovedToSpeaker(true, true, true, false),
+            "mmap external to speaker");
+    expect(!shouldInvalidateMmapMovedToSpeaker(true, true, true, true),
+            "mmap already on speaker");
+    expect(!shouldInvalidateMmapMovedToSpeaker(true, true, false, true),
+            "mmap speaker to external");
+    expect(!shouldInvalidateMmapMovedToSpeaker(true, false, true, false),
+            "non-mmap route change");
+    expect(!shouldInvalidateMmapMovedToSpeaker(false, true, true, false),
+            "mmap move while preference off");
+
+    expect(shouldBlendDirectPcm(true, true, true), "direct pcm mono");
+    expect(!shouldBlendDirectPcm(true, false, true), "offload thread skips blend");
+    expect(!shouldBlendDirectPcm(false, true, true), "direct without mono param");
+    expect(!shouldBlendDirectPcm(true, true, false), "compressed direct skips blend");
+
+    int16_t stereo[4] = {0, 200, 10, 30};
+    averageAudioChannels(stereo, PcmSample::kS16, 2, 0, 2);
+    expect(stereo[0] == 100 && stereo[1] == 100 && stereo[2] == 20 && stereo[3] == 20,
+            "s16 stereo frames");
+
+    int16_t haptic[3] = {0, 100, 7};
+    averageAudioChannels(haptic, PcmSample::kS16, 2, 1, 1);
+    expect(haptic[0] == 50 && haptic[1] == 50 && haptic[2] == 7, "haptic preserved");
+
+    int32_t pcm32[2] = {0, 1000};
+    averageAudioChannels(pcm32, PcmSample::kS32, 2, 0, 1);
+    expect(pcm32[0] == 500 && pcm32[1] == 500, "s32 dsee-style");
+
+    float pcmf[2] = {1.f, 3.f};
+    averageAudioChannels(pcmf, PcmSample::kFloat, 2, 0, 1);
+    expect(pcmf[0] == 2.f && pcmf[1] == 2.f, "float stereo");
+
+    int16_t mono[1] = {9};
+    averageAudioChannels(mono, PcmSample::kS16, 1, 0, 1);
+    expect(mono[0] == 9, "already mono unchanged");
+    averageAudioChannels(stereo, PcmSample::kS16, 2, 0, 2);
+    expect(stereo[0] == 100 && stereo[1] == 100, "second blend stays mono");
+
+    auto packS24 = [](uint8_t* p, int32_t value) {
+        direct_pcm_mono::writeS24Le(p, value);
+    };
+    auto expectS24 = [&](const uint8_t* p, int32_t value, const char* name) {
+        expect(readS24Le(p) == value, name);
+    };
+
+    // Hai khung stereo, khong can 4 byte: bat dau o byte le.
+    uint8_t packed[1 + 12] = {};
+    uint8_t* frames = packed + 1;
+    packS24(frames + 0, 1000);          // L only
+    packS24(frames + 3, 0);
+    packS24(frames + 6, 0);             // R only
+    packS24(frames + 9, 2000);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 2);
+    expectS24(frames + 0, 500, "s24 L-only L");
+    expectS24(frames + 3, 500, "s24 L-only R");
+    expectS24(frames + 6, 1000, "s24 R-only L");
+    expectS24(frames + 9, 1000, "s24 R-only R");
+    expect(packed[0] == 0, "s24 guard byte before unaligned buffer");
+
+    packS24(frames + 0, -1000);
+    packS24(frames + 3, -500);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 1);
+    expectS24(frames + 0, -750, "s24 negative L");
+    expectS24(frames + 3, -750, "s24 negative R");
+
+    packS24(frames + 0, 1000);
+    packS24(frames + 3, -1000);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 1);
+    expectS24(frames + 0, 0, "s24 opposite L");
+    expectS24(frames + 3, 0, "s24 opposite R");
+
+    packS24(frames + 0, direct_pcm_mono::kS24Max);
+    packS24(frames + 3, direct_pcm_mono::kS24Min);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 1);
+    expectS24(frames + 0, 0, "s24 full-scale opposite truncates toward zero");
+    expectS24(frames + 3, 0, "s24 full-scale opposite R");
+
+    packS24(frames + 0, direct_pcm_mono::kS24Max);
+    packS24(frames + 3, direct_pcm_mono::kS24Max);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 1);
+    expectS24(frames + 0, direct_pcm_mono::kS24Max, "s24 full positive stays");
+    expectS24(frames + 3, direct_pcm_mono::kS24Max, "s24 full positive R");
+
+    packS24(frames + 0, direct_pcm_mono::kS24Min);
+    packS24(frames + 3, direct_pcm_mono::kS24Min);
+    averageAudioChannels(frames, PcmSample::kS24Packed, 2, 0, 1);
+    expectS24(frames + 0, direct_pcm_mono::kS24Min, "s24 full negative stays");
+    expectS24(frames + 3, direct_pcm_mono::kS24Min, "s24 full negative R");
+
+    // Stereo + haptic 24-bit. Haptic giu nguyen.
+    uint8_t haptic24[9];
+    packS24(haptic24 + 0, 0);
+    packS24(haptic24 + 3, 300);
+    packS24(haptic24 + 6, -12345);
+    averageAudioChannels(haptic24, PcmSample::kS24Packed, 2, 1, 1);
+    expectS24(haptic24 + 0, 150, "s24 haptic audio L");
+    expectS24(haptic24 + 3, 150, "s24 haptic audio R");
+    expectS24(haptic24 + 6, -12345, "s24 haptic sample");
+
+    uint8_t mono24[3];
+    packS24(mono24, 42);
+    averageAudioChannels(mono24, PcmSample::kS24Packed, 1, 0, 1);
+    expectS24(mono24, 42, "s24 mono input unchanged");
+
+    expect(frameStrideMatches(6, 2, 0, 3), "s24 stereo frame size");
+    expect(frameStrideMatches(9, 2, 1, 3), "s24 stereo plus haptic frame size");
+    expect(!frameStrideMatches(8, 2, 0, 3), "s24 rejects int32 stride");
+    const size_t writeLength = 12;
+    const size_t frameSize = 6;
+    const size_t framesOut = writeLength / frameSize;
+    expect(framesOut * frameSize == writeLength, "partial-write length is whole frames");
+    expect(framesOut * (2 + 0) * 3 == writeLength, "blend covers the same bytes as mSinkBuffer");
+
+    if (gFailures != 0) {
+        std::fprintf(stderr, "%d failed\n", gFailures);
+        return 1;
+    }
+    std::puts("ok");
+    return 0;
+}
