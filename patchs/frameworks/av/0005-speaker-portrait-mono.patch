new file mode 100644
index 0000000000..d1d1e76be0
--- /dev/null
+++ b/services/audioflinger/DirectPcmMono.h
@@ -0,0 +1,125 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Tron mono cho DIRECT PCM. Khong phu thuoc AudioPolicyManager.
+namespace direct_pcm_mono {
+
+enum class PcmSample : int {
+    kUnsupported = 0,
+    kS16 = 1,
+    kS32 = 2,
+    kFloat = 3,
+    kS24Packed = 4,
+};
+
+constexpr int32_t kS24Min = -8388608;
+constexpr int32_t kS24Max = 8388607;
+
+inline bool shouldBlendDirectPcm(bool monoParamOnThisOutput, bool directPcmThread, bool linearPcm) {
+    return monoParamOnThisOutput && directPcmThread && linearPcm;
+}
+
+// 24-bit packed little-endian, co dau. Khong doc nhu int32.
+inline int32_t readS24Le(const uint8_t* p) {
+    int32_t value = static_cast<int32_t>(p[0])
+            | (static_cast<int32_t>(p[1]) << 8)
+            | (static_cast<int32_t>(p[2]) << 16);
+    if ((value & 0x800000) != 0) {
+        value |= ~0xFFFFFF;
+    }
+    return value;
+}
+
+inline void writeS24Le(uint8_t* p, int32_t value) {
+    if (value > kS24Max) {
+        value = kS24Max;
+    } else if (value < kS24Min) {
+        value = kS24Min;
+    }
+    p[0] = static_cast<uint8_t>(value & 0xFF);
+    p[1] = static_cast<uint8_t>((value >> 8) & 0xFF);
+    p[2] = static_cast<uint8_t>((value >> 16) & 0xFF);
+}
+
+// Khung xen ke: audio truoc, haptic sau. Buoc nhay = audio + haptic mau.
+// Trung binh lap lai van la mono. Bo dem khong can can theo 4 byte.
+inline void averageAudioChannels(void* buf, PcmSample sample, size_t audioChannels,
+        size_t hapticChannels, size_t frames) {
+    if (buf == nullptr || audioChannels < 2 || frames == 0 || sample == PcmSample::kUnsupported) {
+        return;
+    }
+    const size_t stride = audioChannels + hapticChannels;
+    if (sample == PcmSample::kS16) {
+        int16_t* out = static_cast<int16_t*>(buf);
+        for (size_t i = 0; i < frames; ++i) {
+            int accum = 0;
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                accum += out[ch];
+            }
+            accum /= static_cast<int>(audioChannels);
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                out[ch] = static_cast<int16_t>(accum);
+            }
+            out += stride;
+        }
+        return;
+    }
+    if (sample == PcmSample::kS32) {
+        int32_t* out = static_cast<int32_t*>(buf);
+        for (size_t i = 0; i < frames; ++i) {
+            int64_t accum = 0;
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                accum += out[ch];
+            }
+            accum /= static_cast<int64_t>(audioChannels);
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                out[ch] = static_cast<int32_t>(accum);
+            }
+            out += stride;
+        }
+        return;
+    }
+    if (sample == PcmSample::kS24Packed) {
+        uint8_t* out = static_cast<uint8_t*>(buf);
+        const size_t strideBytes = stride * 3;
+        for (size_t i = 0; i < frames; ++i) {
+            int64_t accum = 0;
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                accum += readS24Le(out + ch * 3);
+            }
+            accum /= static_cast<int64_t>(audioChannels);
+            const int32_t mixed = static_cast<int32_t>(accum);
+            for (size_t ch = 0; ch < audioChannels; ++ch) {
+                writeS24Le(out + ch * 3, mixed);
+            }
+            out += strideBytes;
+        }
+        return;
+    }
+    float* out = static_cast<float*>(buf);
+    const float scale = 1.f / static_cast<float>(audioChannels);
+    for (size_t i = 0; i < frames; ++i) {
+        float accum = 0.f;
+        for (size_t ch = 0; ch < audioChannels; ++ch) {
+            accum += out[ch];
+        }
+        accum *= scale;
+        for (size_t ch = 0; ch < audioChannels; ++ch) {
+            out[ch] = accum;
+        }
+        out += stride;
+    }
+}
+
+// mFrameSize cua direct = (audio + haptic) * byte/mau, ke ca sau khi tach mask haptic.
+inline bool frameStrideMatches(size_t frameSize, size_t audioChannels, size_t hapticChannels,
+        size_t bytesPerSample) {
+    if (bytesPerSample == 0) {
+        return false;
+    }
+    return frameSize == (audioChannels + hapticChannels) * bytesPerSample;
+}
+
+}  // namespace direct_pcm_mono
