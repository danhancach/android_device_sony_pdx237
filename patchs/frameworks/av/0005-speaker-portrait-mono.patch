+status_t AudioPolicyManager::setSpeakerPortraitMono(bool mono)
+{
+    if (mSpeakerPortraitMono == mono) {
+        return NO_ERROR;
+    }
+    mSpeakerPortraitMono = mono;
+    // Dong offload va MMAP dang gan loa trong. DIRECT PCM (DSEE) va mixer giu route.
+    // Client mo lai: offload thanh PCM, MMAP thanh legacy neu policy khong phai ALWAYS.
+    if (mSpeakerPortraitMono) {
+        std::vector<audio_io_handle_t> unblended;
+        for (size_t i = 0; i < mOutputs.size(); ++i) {
+            sp<SwAudioOutputDescriptor> desc = mOutputs.valueAt(i);
+            const auto types = desc->devices().types();
+            const bool speakerOnly = speaker_portrait_mono::isBuiltinLoudspeakerOnly(
+                    types.begin(), types.end());
+            const bool offload = (desc->mFlags & AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD) != 0;
+            const bool mmap = (desc->mFlags & AUDIO_OUTPUT_FLAG_MMAP_NOIRQ) != 0;
+            if (speakerOnly && (offload || mmap)) {
+                unblended.push_back(desc->mIoHandle);
+            }
+        }
+        for (const auto& handle : unblended) {
+            closeOutput(handle);
+        }
+    }
+    for (size_t i = 0; i < mOutputs.size(); ++i) {
+        updateMono(mOutputs.keyAt(i));
+    }
+    return NO_ERROR;
+}
+
+void AudioPolicyManager::invalidateOffloadOrMmapMovedToSpeaker_l(
+        const sp<SwAudioOutputDescriptor>& outputDesc, const DeviceVector& previousDevices) {
+    if (outputDesc == nullptr || !mSpeakerPortraitMono
+            || (outputDesc->mFlags & (AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD
+                    | AUDIO_OUTPUT_FLAG_MMAP_NOIRQ)) == 0) {
+        return;
+    }
+    const auto nowTypes = outputDesc->devices().types();
+    const auto prevTypes = previousDevices.types();
+    const bool nowSpeaker = speaker_portrait_mono::isBuiltinLoudspeakerOnly(
+            nowTypes.begin(), nowTypes.end());
+    const bool prevSpeaker = speaker_portrait_mono::isBuiltinLoudspeakerOnly(
+            prevTypes.begin(), prevTypes.end());
+    const bool offload = (outputDesc->mFlags & AUDIO_OUTPUT_FLAG_COMPRESS_OFFLOAD) != 0;
+    const bool mmap = (outputDesc->mFlags & AUDIO_OUTPUT_FLAG_MMAP_NOIRQ) != 0;
+    if (!speaker_portrait_mono::shouldInvalidateOffloadMovedToSpeaker(
+                    mSpeakerPortraitMono, offload, nowSpeaker, prevSpeaker)
+            && !speaker_portrait_mono::shouldInvalidateMmapMovedToSpeaker(
+                    mSpeakerPortraitMono, mmap, nowSpeaker, prevSpeaker)) {
+        return;
+    }
+    // Khong closeOutput o day: setOutputDevices co the dang nam trong vong lap output.
+    // Client mo lai. Offload va MMAP tren loa trong deu bi tu choi, getOutput tra NONE.
+    PortHandleVector clientsToInvalidate;
+    for (const auto& client : outputDesc->clientsList()) {
+        if (client->isInvalid()) {
+            continue;
+        }
+        clientsToInvalidate.push_back(client->portId());
+    }
+    if (!clientsToInvalidate.empty()) {
+        ALOGI("speaker portrait mono: invalidate %s moved to speaker output %d",
+                mmap ? "mmap" : "offload", outputDesc->mIoHandle);
+        mpClientInterface->invalidateTracks(clientsToInvalidate);
+    }
+}
