diff --git a/services/audiopolicy/managerdefault/SpeakerPortraitMono.h b/services/audiopolicy/managerdefault/SpeakerPortraitMono.h
new file mode 100644
index 0000000000..6fea06f702
--- /dev/null
+++ b/services/audiopolicy/managerdefault/SpeakerPortraitMono.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <cstddef>
+#include <iterator>
+
+// Quyet dinh mono loa trong. Khong dung Settings.System.master_mono.
+namespace speaker_portrait_mono {
+
+constexpr unsigned kDeviceOutSpeaker = 0x2u;
+constexpr unsigned kDeviceOutSpeakerSafe = 0x400000u;
+
+inline bool isBuiltinLoudspeakerType(unsigned deviceType) {
+    return deviceType == kDeviceOutSpeaker || deviceType == kDeviceOutSpeakerSafe;
+}
+
+// Rong hoac co thiet bi khac loa trong -> khong ap dung mono tuy chinh.
+template <typename It>
+inline bool isBuiltinLoudspeakerOnly(It begin, It end) {
+    if (begin == end) {
+        return false;
+    }
+    for (It it = begin; it != end; ++it) {
+        if (!isBuiltinLoudspeakerType(static_cast<unsigned>(*it))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+inline bool isPortrait(int rotationDegrees) {
+    return rotationDegrees == 0 || rotationDegrees == 180;
+}
+
+inline bool isRequested(bool preferenceEnabled, int rotationDegrees) {
+    return preferenceEnabled && isPortrait(rotationDegrees);
+}
+
+// masterMono la Accessibility, ap dung moi output. speakerPortrait chi them loa trong.
+inline bool outputShouldMono(bool accessibilityMasterMono, bool speakerPortraitRequested,
+        bool builtinLoudspeakerOnly) {
+    return accessibilityMasterMono || (speakerPortraitRequested && builtinLoudspeakerOnly);
+}
+
+// Offload da mo o thiet bi ngoai, roi chuyen sang loa trong khi co dang bat.
+inline bool shouldInvalidateOffloadMovedToSpeaker(bool speakerPortraitMono, bool compressOffload,
+        bool nowBuiltinSpeakerOnly, bool previouslyBuiltinSpeakerOnly) {
+    return speakerPortraitMono && compressOffload && nowBuiltinSpeakerOnly
+            && !previouslyBuiltinSpeakerOnly;
+}
+
+// MMAP_NOIRQ khong di qua mixer/DIRECT write. Chi tu choi khi dung loa trong.
+inline bool shouldRefuseMmapOnSpeaker(bool speakerPortraitMono, bool mmapNoIrq,
+        bool builtinLoudspeakerOnly) {
+    return speakerPortraitMono && mmapNoIrq && builtinLoudspeakerOnly;
+}
+
+// MMAP da mo o thiet bi ngoai, roi chuyen sang loa trong. Khong dong output trong setOutputDevices.
+inline bool shouldInvalidateMmapMovedToSpeaker(bool speakerPortraitMono, bool mmapNoIrq,
+        bool nowBuiltinSpeakerOnly, bool previouslyBuiltinSpeakerOnly) {
+    return speakerPortraitMono && mmapNoIrq && nowBuiltinSpeakerOnly
+            && !previouslyBuiltinSpeakerOnly;
+}
+
+}  // namespace speaker_portrait_mono
