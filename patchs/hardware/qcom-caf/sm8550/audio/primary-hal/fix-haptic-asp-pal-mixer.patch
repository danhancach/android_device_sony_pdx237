+bool StreamOutPrimary::findCs40HapticAlsaDevice(int* card, int* device) {
+    // Tim PCM playback gan cs40l2x (vd. MI2S-LPAIF-RX-PRIMARY cs40l2x-codec)
+    std::ifstream pcmFile("/proc/asound/pcm");
+    if (!pcmFile.is_open()) {
+        AHAL_ERR("cannot open /proc/asound/pcm");
+        return false;
+    }
+    std::string line;
+    while (std::getline(pcmFile, line)) {
+        if (line.find("cs40l2x") == std::string::npos)
+            continue;
+        if (line.find("playback") == std::string::npos)
+            continue;
+        int c = 0, d = 0;
+        if (sscanf(line.c_str(), "%d-%d:", &c, &d) == 2) {
+            *card = c;
+            *device = d;
+            AHAL_DBG("found cs40 haptic ALSA pcm %d-%d", c, d);
+            return true;
+        }
+    }
+    AHAL_ERR("cs40l2x playback PCM not found in /proc/asound/pcm");
+    return false;
+}
+
+void StreamOutPrimary::releaseHapticMixerLocked() {
+    if (hapticMixer_) {
+        mixer_close(hapticMixer_);
+        hapticMixer_ = nullptr;
+        hapticMixerCard_ = -1;
+    }
+}
+
+struct mixer* StreamOutPrimary::getHapticMixerLocked() {
+    int card = hapticAlsaCard_;
+    if (card < 0) {
+        int dev = 0;
+        if (!findCs40HapticAlsaDevice(&card, &dev))
+            card = 0;
+        hapticAlsaCard_ = card;
+    }
+    if (hapticMixer_ && hapticMixerCard_ == card)
+        return hapticMixer_;
+    releaseHapticMixerLocked();
+    hapticMixer_ = mixer_open(card);
+    if (!hapticMixer_) {
+        AHAL_ERR("mixer_open card %d failed", card);
+        return nullptr;
+    }
+    hapticMixerCard_ = card;
+    return hapticMixer_;
+}
+
+int StreamOutPrimary::setHapticsMixerSourcePcmLocked() {
+    struct mixer *mx = getHapticMixerLocked();
+    if (!mx)
+        return -ENODEV;
+
+    int ret = 0;
+    struct mixer_ctl *src = mixer_get_ctl_by_name(mx, "Haptics Source");
+    if (src) {
+        ret = mixer_ctl_set_enum_by_string(src, "PCM");
+        AHAL_DBG("mixer Haptics Source=PCM card=%d ret=%d", hapticAlsaCard_, ret);
+    } else {
+        AHAL_ERR("mixer ctl Haptics Source not found on card %d", hapticAlsaCard_);
+        ret = -ENOENT;
+    }
+
+    // Unmute A2H: AUDIOLEFT/RIGHT ENABLE can =1 (mute On -> khong rung).
+    // Bleed loa xu ly bang tach kenh HAL, khong can mute A2H.
+    struct mixer_ctl *a2hMute = mixer_get_ctl_by_name(mx, "A2H Mute Switch");
+    if (a2hMute) {
+        int mret = mixer_ctl_set_value(a2hMute, 0, 0);
+        mret |= mixer_ctl_set_value(a2hMute, 1, 0);
+        AHAL_DBG("mixer A2H Mute=Off ret=%d", mret);
+    }
+
+    return ret;
+}
