From 956110bd480ae162c6385d2eaed2fe841075d366 Mon Sep 17 00:00:00 2001
From: danhancach <111163507+danhancach@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:47:14 +0900
Subject: [PATCH] audio: FCC limit 13 for 360RA

---
 audio/include/system/audio.h | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/audio/include/system/audio.h b/audio/include/system/audio.h
index e9d6002d..0e63c098 100644
--- a/audio/include/system/audio.h
+++ b/audio/include/system/audio.h
@@ -238,6 +238,7 @@ enum {
     FCC_2 = 2,
     FCC_8 = 8,
     FCC_12 = 12,
+    FCC_13 = 13,
     FCC_24 = 24,
     FCC_26 = 26,
     // FCC_LIMIT is the maximum PCM channel count supported through
@@ -245,7 +246,8 @@ enum {
     //
     // This can be adjusted onto a value such as FCC_12 or FCC_26
     // if the device HAL can support it.  Do not reduce below FCC_8.
-    FCC_LIMIT = FCC_12,
+    // 360RA MPEG-H decoder xuat PCM 13ch (CHANNEL_OUT_13POINT0).
+    FCC_LIMIT = FCC_13,
 };
 
 /* A channel mask per se only defines the presence or absence of a channel, not the order.
-- 
