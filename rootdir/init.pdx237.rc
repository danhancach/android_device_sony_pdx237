# pdx237: disable A17 background audio hardening after boot (merchant notification audio).

on property:sys.boot_completed=1
    start disable-audio-hardening

# sh_binary device_specific → /odm/bin (khong phai /system/bin)
service disable-audio-hardening /odm/bin/disable_audio_hardening.sh
    class late_start
    user shell
    group shell audio
    oneshot
    disabled
