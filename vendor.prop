# Bluetooth
bluetooth.device.default_name=Xperia 5 V

# Fingerprint
persist.vendor.fingerprint.type=side
persist.vendor.fingerprint.sensor_location=1080|1150|240|local:131

# Chikugo camera: privileged client bypass for stream dimension validation
persist.vendor.camera.privapp.list=com.sonymobile.photopro,jp.co.sony.mc.cameraapp

# Smooth display — idle ngan hon OEM; touch boost giu lau vua phai
ro.surface_flinger.set_idle_timer_ms=2000
ro.surface_flinger.set_touch_timer_ms=1000
ro.surface_flinger.set_display_power_timer_ms=1000
